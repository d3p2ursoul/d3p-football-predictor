# Environment variables for Football Predictor

# Backend
FLASK_ENV=development
PORT=5000
DATABASE_URL=sqlite:///football_predictor.db
SECRET_KEY=dev-secret-key-change-in-production

# RapidAPI Configuration
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=api-football-v3.p.rapidapi.com

# TheSportsDB Configuration (optional)
THESPORTSDB_API_KEY=your_thesportsdb_key_here

# Frontend
REACT_APP_API_URL=http://localhost:5000/api
